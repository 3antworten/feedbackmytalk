# Copy this file to .env before running docker compose.
# Only JWT_SECRET is strongly recommended to change.

JWT_SECRET=replace-with-a-long-random-string-in-production
APP_DOMAIN=https://feedbackmytalk.example.com

# Production hardening
CORS_ORIGIN=https://feedbackmytalk.example.com
COOKIE_SECURE=true

# Optional mail configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey-or-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=no-reply@feedbackmytalk.com
